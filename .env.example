# Copy to .env (git-ignored) and fill in. Never commit real values.

# Task launcher; only "docker" exists so far.
ENGINE_LAUNCHER=docker
# Docker image that runs agentic-bridge
ENGINE_IMAGE=
# Docker network shared by this UI and the task containers
ENGINE_DOCKER_NETWORK=
# Absolute directory for task records (outside the repository)
ENGINE_DATA_DIR=
# Default repository that tasks clone
ENGINE_REPO_URL=
# Project name passed to tasks
ENGINE_PROJECT=
# Maximum running task containers
ENGINE_MAX_RUNNING=2
# Test hooks (optional): JSON object of strings, JSON array of "host:container[:mode]"
ENGINE_TASK_EXTRA_ENV=
ENGINE_TASK_EXTRA_BINDS=

# Secrets
CLAUDE_CODE_OAUTH_TOKEN=
GH_TOKEN=
