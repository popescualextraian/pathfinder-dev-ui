# Copy to .env (git-ignored) and fill in. Never commit real values.

# Task launcher: docker, or local (processes, no isolation, development only; see README, or npm run start:local)
ENGINE_LAUNCHER=docker
# Docker image that runs agentic-bridge
ENGINE_IMAGE=
# Docker network shared by this UI and the task containers
ENGINE_DOCKER_NETWORK=
# Absolute directory for task records (outside the repository)
ENGINE_DATA_DIR=
# Default repository that tasks clone
ENGINE_REPO_URL=
# Extra hosts a task's repoUrl may use, comma separated (the host of ENGINE_REPO_URL is always allowed)
ENGINE_ALLOWED_REPO_HOSTS=
# More repositories tasks can be started in by name: JSON array of {"name", "url"} (https, no credentials); their hosts are allowed
ENGINE_REPOS=
# Seconds between two rounds of the task poller
ENGINE_POLL_SECONDS=15
# Project name passed to tasks
ENGINE_PROJECT=
# Commit author and committer of task containers (required)
ENGINE_GIT_NAME=
ENGINE_GIT_EMAIL=
# Maximum running task containers
ENGINE_MAX_RUNNING=2
# Test hooks (optional): JSON object of strings, JSON array of "host:container[:mode]"
ENGINE_TASK_EXTRA_ENV=
# Does not work with the compose setup: its Docker socket filter refuses launches with extra binds (403). Only for npm start with a plain Docker socket.
ENGINE_TASK_EXTRA_BINDS=

# Backlog board (optional): path of the lanes YAML (copy backlog.example.yaml); unset = no backlog routes, no board.
# compose.yaml does not read BACKLOG_CONFIG: it uses BACKLOG_CONFIG_FILE (host path of the YAML) and sets the container paths itself.
BACKLOG_CONFIG=
# Absolute directory for the backlog cache (required when BACKLOG_CONFIG is set)
BACKLOG_DATA_DIR=

# Workflows (optional; on only when BACKLOG_CONFIG and WORKFLOWS_DIR are both set, WORKFLOWS_DIR alone is ignored):
# absolute directory of the workflow definitions, one YAML file per workflow (see workflows.example/)
WORKFLOWS_DIR=
# Absolute directory for the workflow runs, one file per run (required when workflows are on)
WORKFLOWS_DATA_DIR=

# Schedules (always on). Absolute directory of the schedules, one file per schedule with its results
# (default: `schedules` next to ENGINE_DATA_DIR; compose.yaml sets /data/schedules itself)
SCHEDULES_DATA_DIR=
# IANA zone of cron lines and one-off times (default: the zone of the process), for example SCHEDULES_TIMEZONE=Europe/Berlin
SCHEDULES_TIMEZONE=
# Seconds between two looks for due schedules (default 30)
SCHEDULES_TICK_SECONDS=

# compose.yaml does not read WORKFLOWS_DIR: it uses WORKFLOWS_DIR_HOST (host path of the definitions) and sets the container paths itself.
WORKFLOWS_DIR_HOST=

# compose.yaml only (see README, Deployment): numeric group id of the host's Docker socket (stat -c %g /var/run/docker.sock), required.
# The filter service gets ENGINE_IMAGE and the network agentic-ui from compose; ENGINE_LAUNCHER, ENGINE_DOCKER_NETWORK and ENGINE_DATA_DIR are set by compose.
# Keep this file elsewhere if you like and give its path as PATHFINDER_ENV_FILE (tools/deploy.sh <env-file> does).
DOCKER_GID=
# Host port of the UI (127.0.0.1 only)
UI_PORT=3000
# Host path of the lanes YAML (BACKLOG_CONFIG_FILE) turns the backlog on in compose, like WORKFLOWS_DIR_HOST for workflows (above)
BACKLOG_CONFIG_FILE=

# Secrets
CLAUDE_CODE_OAUTH_TOKEN=
GH_TOKEN=
# Backlog connector token. The variable NAME is gitlab.tokenEnv in the lanes YAML (GITLAB_TOKEN in the example); needs the api scope.
GITLAB_TOKEN=
