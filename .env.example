# Copy to .env (git-ignored) and fill in. Never commit real values.

# Task launcher: docker, or local (processes, no isolation, development only; see README, or npm run start:local)
ENGINE_LAUNCHER=docker
# Docker image that runs agentic-bridge
ENGINE_IMAGE=
# Docker network shared by this UI and the task containers
ENGINE_DOCKER_NETWORK=
# Absolute directory for task records (outside the repository)
ENGINE_DATA_DIR=
# Default repository that tasks clone
ENGINE_REPO_URL=
# Extra hosts a task's repoUrl may use, comma separated (the host of ENGINE_REPO_URL is always allowed)
ENGINE_ALLOWED_REPO_HOSTS=
# More repositories tasks can be started in by name: JSON array of {"name", "url"} (https, no credentials); their hosts are allowed
ENGINE_REPOS=
# Seconds between two rounds of the task poller
ENGINE_POLL_SECONDS=15
# Project name passed to tasks
ENGINE_PROJECT=
# Commit author and committer of task containers (required)
ENGINE_GIT_NAME=
ENGINE_GIT_EMAIL=
# Maximum running task containers
ENGINE_MAX_RUNNING=2
# Test hooks (optional): JSON object of strings, JSON array of "host:container[:mode]"
ENGINE_TASK_EXTRA_ENV=
ENGINE_TASK_EXTRA_BINDS=

# Backlog board (optional): path of the lanes YAML (copy backlog.example.yaml); unset = no backlog routes, no board.
# compose.yaml does not read BACKLOG_CONFIG: it uses BACKLOG_CONFIG_FILE (host path of the YAML) and sets the container paths itself.
BACKLOG_CONFIG=
# Absolute directory for the backlog cache (required when BACKLOG_CONFIG is set)
BACKLOG_DATA_DIR=

# Secrets
CLAUDE_CODE_OAUTH_TOKEN=
GH_TOKEN=
# Backlog connector token. The variable NAME is gitlab.tokenEnv in the lanes YAML (GITLAB_TOKEN in the example); needs the api scope.
GITLAB_TOKEN=
