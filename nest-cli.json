{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "backend/src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "backend/tsconfig.build.json",
    "assets": [
      {
        "include": "workflow/service/generator/*.md",
        "watchAssets": true
      }
    ]
  }
}
