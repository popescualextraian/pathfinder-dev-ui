{
  "name": "pathfinder-dev-ui",
  "version": "0.1.0",
  "private": true,
  "description": "UI for agentic-dev-base",
  "license": "MIT",
  "scripts": {
    "build": "nest build && vite build --config frontend/vite.config.mts",
    "start": "node dist/backend/main.js",
    "start:local": "node tools/start-local.mjs",
    "lint": "eslint \"backend/{src,test}/**/*.ts\" \"socket-filter/{src,test}/**/*.ts\"",
    "test": "jest",
    "test:filter": "jest --config socket-filter/jest.config.js",
    "test:e2e": "jest --config backend/test/e2e/jest-e2e.config.js",
    "test:bridge": "jest --config backend/test/bridge/jest-bridge.config.js --runInBand",
    "test:docker": "jest --config backend/test/docker/jest-docker.config.js --runInBand",
    "test:docker:filter": "jest --config backend/test/docker-filter/jest-docker-filter.config.js --runInBand",
    "test:ui": "playwright test",
    "dev:frontend": "vite --config frontend/vite.config.mts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/serve-static": "^5.0.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "croner": "^10.0.1",
    "dockerode": "^5.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/dockerode": "^4.0.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
